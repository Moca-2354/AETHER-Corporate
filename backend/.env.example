# =========================
# Application
# =========================
APP_MODE=live
REQUIRE_LOGIN=true

FRONTEND_URL=http://localhost:3000

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# =========================
# Azure AI Search
# =========================
AZURE_SEARCH_SERVICE_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=YOUR_AZURE_SEARCH_KEY
AZURE_SEARCH_INDEX_NAME=aether-people
AZURE_SEARCH_VECTOR_FIELD=embedding

# =========================
# Azure OpenAI / AI Foundry
# =========================
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_KEY

AZURE_OPENAI_DEPLOYMENT_NAME=aether-chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=aether-embedding

# =========================
# Microsoft Entra ID
# =========================
CLIENT_ID=YOUR_CLIENT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET
TENANT_ID=YOUR_TENANT_ID

REDIRECT_URI=http://localhost:3000/api/callback/

SCOPE=["User.Read","Mail.Read"]

# =========================
# Session
# =========================
SESSION_ENCRYPTION_KEY=YOUR_FERNET_KEY
SESSION_DB=.runtime/sessions.sqlite3
SESSION_TTL_SECONDS=28800